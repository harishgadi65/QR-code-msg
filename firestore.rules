rules_version = '2';

// All reads and writes to qrCodes/batches/counters go through Cloud Functions
// using the Admin SDK (which bypasses these rules). Direct client access is
// denied entirely so status transitions, uploads, and admin actions can only
// happen through the validated, transactional server code in functions/src.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
