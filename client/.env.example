# Firebase web app config (Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public URL where this app is hosted, used to build QR code links
# (becomes https://domain.com/#/m/QR-000001 — see src/main.tsx for why the "#")
VITE_APP_BASE_URL=http://localhost:5173

# Only needed when the frontend is NOT served from Firebase Hosting (e.g. GitHub
# Pages), since there's no "/api/**" rewrite to rely on there. Point this at the
# deployed function directly, e.g.:
#   https://us-central1-<project-id>.cloudfunctions.net/api
# Leave unset when deploying to Firebase Hosting or running the local emulators.
VITE_API_BASE_URL=
