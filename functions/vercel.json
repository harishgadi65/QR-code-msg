{
  "framework": null,
  "buildCommand": "echo skip",
  "functions": {
    "api/**/*.ts": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "node_modules/@ffprobe-installer/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    }
  ]
}
