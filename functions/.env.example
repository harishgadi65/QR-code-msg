# Google Drive OAuth2 credentials (Desktop app client, see scripts/getGoogleDriveToken.ts)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Folder ID of the Google Drive folder that will hold QR-MEMORIES/ (must be shared/owned
# by the same account used to generate the refresh token above)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Comma-separated emails that are auto-granted the admin claim on sign-up.
# Primary admin creation should go through scripts/createAdmin.ts instead.
ADMIN_EMAILS=

# Public app URL (same as client VITE_APP_BASE_URL), used in server-generated links/logs
APP_BASE_URL=http://localhost:5173

# Content limits (all optional, defaults shown)
MAX_VIDEO_DURATION_SECONDS=60
MAX_VIDEO_SIZE_MB=80
MAX_PHOTO_SIZE_MB=15
MAX_MESSAGE_LENGTH=500
MAX_NAME_LENGTH=60
PENDING_UPLOAD_TIMEOUT_MS=120000
