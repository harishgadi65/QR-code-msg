# Google Drive OAuth2 credentials (Desktop app client, see scripts/getGoogleDriveToken.ts)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Folder ID of the "QR-MEMORIES" root folder — printed by scripts/getGoogleDriveToken.ts,
# which creates it for you (it can't be created by hand in the Drive website; see the
# drive.file scope note in the README's Google Drive setup section).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Public app URL (same as client VITE_APP_BASE_URL), used in server-generated links/logs
APP_BASE_URL=http://localhost:5173

# Content limits (all optional, defaults shown)
MAX_VIDEO_DURATION_SECONDS=30
MAX_VIDEO_SIZE_MB=80
MAX_PHOTO_SIZE_MB=15
MAX_MESSAGE_LENGTH=500
MAX_NAME_LENGTH=60
# Generous enough to cover a slow mobile upload straight to Drive without the QR
# getting reclaimed as abandoned while a legitimate upload is still in flight.
PENDING_UPLOAD_TIMEOUT_MS=480000
